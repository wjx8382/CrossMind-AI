# Safe default: the full Agent workflow runs with deterministic Mock responses.
AI_PROVIDER=mock

# Enable the hackathon Token Plan only in a private deployment environment.
# AI_PROVIDER=bailian
# DASHSCOPE_API_KEY=replace-with-your-private-key
AI_MODEL=qwen3.7-plus
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Change these before exposing PostgreSQL outside a local machine.
POSTGRES_DB=crossmind
POSTGRES_USER=crossmind
POSTGRES_PASSWORD=change-me
APP_PORT=8080
